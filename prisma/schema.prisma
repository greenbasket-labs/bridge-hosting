generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { CUSTOMER ADMIN }
enum AppStatus { CREATING BUILDING DEPLOYING LIVE FAILED SUSPENDED STOPPING STARTING }
enum DeploymentStatus { QUEUED BUILDING BUILD_FAILED DEPLOYING HEALTH_CHECK SUCCESS FAILED CANCELLED ROLLED_BACK }
enum DomainStatus { NOT_CONFIGURED DNS_PENDING VERIFYING VERIFIED SSL_PENDING ACTIVE ERROR }
enum BillingInterval { MONTHLY YEARLY }
enum SubscriptionStatus { TRIALING ACTIVE PAST_DUE CANCELLED }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  role UserRole @default(CUSTOMER)
  customer Customer?
  sessions Session[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Customer {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  applications Application[]
  subscriptions Subscription[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(cuid())
  token String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model Application {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Cascade)
  name String
  repository String?
  repositoryProvider String @default("github")
  branch String @default("main")
  buildCommand String?
  startCommand String?
  rootDirectory String?
  environmentVariables Json?
  status AppStatus @default(CREATING)
  deploymentStatus String?
  internalDomain String @unique
  customDomain String?
  provider String @default("local")
  providerResourceId String?
  deployments Deployment[]
  domains Domain[]
  usageRecords UsageRecord[]
  backups Backup[]
  subscription Subscription?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
}
model Deployment {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  commitSha String?
  branch String?
  commitMessage String?
  status DeploymentStatus @default(QUEUED)
  logs String @default("")
  errorMessage String?
  buildStartedAt DateTime?
  buildFinishedAt DateTime?
  deploymentStartedAt DateTime?
  deploymentFinishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}
model Domain {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  hostname String @unique
  status DomainStatus @default(NOT_CONFIGURED)
  verificationToken String?
  target String?
  sslActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Plan {
  id String @id @default(cuid())
  name String @unique
  cpuCores Float @default(0.5)
  ramMb Int @default(512)
  databaseGb Float @default(1)
  fileStorageGb Float @default(5)
  bandwidthGb Float @default(20)
  requests Int @default(100000)
  concurrentUsers Int @default(25)
  backupRetentionDays Int @default(0)
  deploymentLimit Int @default(30)
  priceKobo BigInt @default(0)
  billingInterval BillingInterval @default(MONTHLY)
  active Boolean @default(true)
  subscriptions Subscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Subscription {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Cascade)
  applicationId String @unique
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  planId String
  plan Plan @relation(fields:[planId], references:[id])
  status SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model UsageRecord {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  cpuPercent Float @default(0)
  ramPercent Float @default(0)
  storagePercent Float @default(0)
  bandwidthPercent Float @default(0)
  databasePercent Float @default(0)
  requests Int @default(0)
  concurrentUsers Int @default(0)
  recordedAt DateTime @default(now())
  @@index([applicationId, recordedAt])
}
model Backup {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  status String @default("PENDING")
  storageRef String?
  sizeBytes BigInt?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model ProviderConfig {
  id String @id @default(cuid())
  name String @unique
  type String
  enabled Boolean @default(true)
  config Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
